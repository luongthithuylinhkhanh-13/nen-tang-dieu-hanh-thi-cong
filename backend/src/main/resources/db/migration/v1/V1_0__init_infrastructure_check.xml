<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!--
        V1.0 - Infrastructure Check Migration
        Mục đích: Xác minh Liquibase UP và rollback hoạt động đúng.
        Không chứa business schema.
        Business schema sẽ được thêm vào sau khi có ERD/specification được team phê duyệt.
    -->
    <changeSet id="V1.0-infrastructure-check" author="phase1-setup">
        <comment>
            Infrastructure verification migration.
            Tạo bảng schema_version để xác nhận Liquibase kết nối và chạy migration thành công.
            Rollback: DROP TABLE schema_version.
        </comment>

        <createTable tableName="schema_version"
                     remarks="Infrastructure check table. Created by Phase 1 setup to verify Liquibase migration pipeline.">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="version_tag" type="VARCHAR(100)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="description" type="TEXT">
                <constraints nullable="true"/>
            </column>
            <column name="applied_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <insert tableName="schema_version">
            <column name="version_tag" value="phase1-infrastructure"/>
            <column name="description" value="Phase 1: Spring Boot + PostgreSQL + Liquibase setup verified"/>
        </insert>

        <rollback>
            <dropTable tableName="schema_version"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
